// The fast-mcp-scala library: one MCP core in `shared/`, three platform targets around it.
// Cross-cutting build vocabulary (versions, compiler flags, publish + module traits) lives in the
// root `build.mill` and is referenced here as `build.<name>`.
package build.`fast-mcp-scala`

import mill._
import mill.api.BuildCtx
import mill.scalalib._
import mill.scalalib.scalafmt._
import mill.scalajslib._
import mill.scalajslib.api._
import mill.scalajslib.bun._
import mill.scalanativelib._
import build.{BinaryCompatTests, BuildConfig, CrossPlatformTests, FastMCPModule,
  FastMCPPublishingBase, FastMCPTestModule, ScalaJSTestDepsFix, SharedTests, Versions,
  scala3Version}

// Namespace module. Aggregate tasks at this level fan out to all three platform children so
// `./mill fast-mcp-scala.compile` and `./mill fast-mcp-scala.test` cover the whole project
// without having to spell out each platform.
object `package` extends Module {

  /** Compile the JVM, Scala.js, and Scala Native sources. */
  def compile: T[Unit] = Task {
    jvm.compile()
    js.compile()
    scalaNative.compile()
    ()
  }

  /** Run the JVM test suite, the Scala.js/Bun conformance tests, and the Scala Native tests. */
  def test: T[Unit] = Task {
    jvm.test.testForked()()
    js.test.testForked()()
    scalaNative.test.testForked()()
    ()
  }

  /** Scalafmt check on every Scala source (shared/, jvm/, js/, native/). */
  def checkFormat: T[Unit] = Task {
    jvm.checkFormat()()
    js.checkFormat()()
    scalaNative.checkFormat()()
    compat.mima.checkFormat()()
    compat.client.checkFormat()()
    ()
  }

  /** Auto-format every Scala source (shared/, jvm/, js/, native/). */
  def reformat: T[Unit] = Task {
    jvm.reformat()()
    js.reformat()()
    scalaNative.reformat()()
    compat.mima.reformat()()
    compat.client.reformat()()
    ()
  }

  /** Binary compatibility check: MiMa compares the current JVM jar with each released version in
    * `Versions.binaryCompatBaselines` and fails on any problem that `.github/mima-exclusions` does
    * not list with a reason. An exclusion that matches nothing fails too. See CONTRIBUTING.md.
    *
    * MiMa gets the current module's dependency classpath for both sides, as sbt-mima does, so each
    * baseline costs one download: its jar.
    *
    * A command, not a cached task: every run prints the report.
    */
  def mimaCheck() = Task.Command {
    val classpath = Task.dest / "classpath.txt"
    os.write.over(classpath, jvm.compileClasspath().map(_.path.toString).mkString("\n"))
    val baselines = compat.baselineJars().map((version, jar) => s"$version=${jar.path}")
    val result = mill.util.Jvm.callProcess(
      mainClass = "fastmcp.compat.Mima",
      mainArgs = Seq(
        compat.mimaExclusions().path.toString,
        classpath.toString,
        jvm.jar().path.toString
      ) ++ baselines,
      classPath = compat.mima.runClasspath().map(_.path),
      stdin = os.Inherit,
      stdout = os.Inherit,
      stderr = os.Inherit,
      check = false
    )
    if (result.exitCode != 0)
      Task.fail(s"binary compatibility check failed (exit ${result.exitCode}); see the report above")
  }

  object jvm extends FastMCPModule {

    // JVM module reads from shared/ (the MCP core), jvm/src/ (ZIO HTTP + System.in/out), and
    // jvm-native/src/ (the socket HTTP layer shared with Scala Native — it must satisfy the JVM
    // WartRemover tiers, which is why it is compiled here under the full flag set).
    override def sources = Task.Sources(
      moduleDir / "src",
      moduleDir / os.up / "shared" / "src",
      moduleDir / os.up / "jvm-native" / "src"
    )

    override def mvnDeps = Seq(
      // ZIO Core
      mvn"dev.zio::zio:${Versions.zio}",
      mvn"dev.zio::zio-json:${Versions.zioJson}",
      // ZIO HTTP for HTTP transports (stateless + streamable). Netty is deliberately NOT declared
      // here: zio-http 3.11.4 brings netty 4.2.17.Final itself, so the io.netty tree is a
      // transitive dependency again and a stdio-only consumer sheds it by excluding
      // `dev.zio:zio-http_3` alone (docs/native-image.md). The TJC-2327 direct pins that overrode
      // zio-http 3.4.0's 4.2.3.Final are gone with the bump.
      mvn"dev.zio::zio-http:${Versions.zioHttp}",
      // SKILL.md frontmatter parsing for the Skills extension (see Versions.scalaYaml).
      mvn"org.virtuslab::scala-yaml:${Versions.scalaYaml}"
    )

    // The netty BOM lands in the published POM as an `import`-scoped `pom` entry — the one place
    // this build speaks about netty's version. A consumer whose resolver honours it (coursier: Mill,
    // sbt, scala-cli) keeps every io.netty module zio-http requests on `Versions.netty`, including
    // the classified native artifacts (`linux-x86_64`, `osx-aarch_64`, ...) that a plain
    // `groupId:artifactId` pin cannot address under Maven's per-classifier mediation; and it is the
    // switch to flip if a netty advisory lands before zio-http moves. A BOM import pulls in no
    // artifact of its own, so excluding zio-http still removes netty from the classpath.
    override def bomMvnDeps = Seq(mvn"io.netty:netty-bom:${Versions.netty}")

    // Managed (not direct) versions for the org.bouncycastle modules netty-pkitesting drags in —
    // see Versions.bouncyCastle for the advisories. Lands in the POM as dependencyManagement.
    override def depManagement = Seq(
      mvn"org.bouncycastle:bcprov-jdk18on:${Versions.bouncyCastle}",
      mvn"org.bouncycastle:bcpkix-jdk18on:${Versions.bouncyCastle}",
      mvn"org.bouncycastle:bcutil-jdk18on:${Versions.bouncyCastle}"
    )

    // jvm/test/src plus the socket-HTTP tests in jvm-native/test/src (CrossPlatformTests), which the
    // Scala Native test module compiles too — the same suite runs on both platforms.
    //
    // BinaryCompatTests adds the classes of `compat.client`, which is compiled against a released
    // version: BinaryCompatibilityTest runs them on the current classes.
    object test extends ScalaTests with FastMCPTestModule with CrossPlatformTests
        with BinaryCompatTests {
      override def mvnDeps = Seq(
        mvn"org.scalatest::scalatest:${Versions.scalaTest}",
        mvn"org.scalacheck::scalacheck:${Versions.scalaCheck}"
      )

      override def binaryCompatClient = Task { compat.client.compile().classes }
    }
  }

  /** Binary compatibility tooling for the JVM artifact (TJC-5134). Nothing here is published.
    *
    *   - `mima`: the MiMa runner behind `fast-mcp-scala.mimaCheck`.
    *   - `client`: a small program compiled against the released `Versions.binaryCompatClient`.
    *     The JVM test suite runs it on the current classes (`BinaryCompatibilityTest`), which
    *     proves at link time what MiMa reports from the class files.
    */
  object compat extends Module {

    /** The released JVM jar of every baseline, each alone: no transitive dependencies. */
    def baselineJars: T[Seq[(String, PathRef)]] = Task {
      Versions.binaryCompatBaselines.map { version =>
        val released = mvn"${build.organization}:fast-mcp-scala_3:$version"
        val alone = released.copy(dep = released.dep.withTransitive(false))
        version -> jvm.defaultResolver().classpath(Seq(alone)).head
      }
    }

    /** The released jar `client` is compiled against. */
    def clientBaselineJar: T[PathRef] = Task {
      baselineJars()
        .collectFirst { case (Versions.binaryCompatClient, jar) => jar }
        .getOrElse(
          Task.fail(
            s"Versions.binaryCompatClient (${Versions.binaryCompatClient}) is not in " +
              s"binaryCompatBaselines (${Versions.binaryCompatBaselines.mkString(", ")})"
          )
        )
    }

    /** Accepted MiMa problems, one per line with a reason. Format: the file's own header. */
    def mimaExclusions: T[PathRef] = Task.Source(BuildCtx.workspaceRoot / ".github" / "mima-exclusions")

    object mima extends ScalaModule with ScalafmtModule {
      override def scalaVersion: T[String] = scala3Version
      override def mvnDeps = Seq(mvn"com.typesafe::mima-core:${Versions.mimaCore}")
    }

    object client extends ScalaModule with ScalafmtModule {
      override def scalaVersion: T[String] = scala3Version

      // The third-party dependencies of the current JVM module, and the released library jar in
      // place of the current sources. Only that one jar is an extra download.
      override def mvnDeps = Task { jvm.mvnDeps() }
      override def unmanagedClasspath = Task { Seq(clientBaselineJar()) }
    }
  }

  // Scala.js target — Bun transport adapters (Bun.serve + Node stdio) over the native MCP core
  // in shared/. Cross-published to Maven Central as `com.tjclp:fast-mcp-scala_sjs1_3`.
  object js extends BunScalaJSModule with BunPublishModule with ScalafmtModule
      with FastMCPPublishingBase {
    def scalaVersion = scala3Version
    def scalaJSVersion = Versions.scalaJs

    override def moduleKind = Task { ModuleKind.ESModule }

    // JS module reads from shared/ (the whole MCP core, incl. the schema-derivation macros) and
    // js/src/ (Bun transport + facades).
    override def sources = Task.Sources(moduleDir / "src", moduleDir / os.up / "shared" / "src")

    // Shared deps needed by shared/ sources and the JS macro/schema derivation path.
    override def mvnDeps = Seq(
      mvn"dev.zio::zio::${Versions.zio}",
      mvn"dev.zio::zio-json::${Versions.zioJson}",
      mvn"org.virtuslab::scala-yaml::${Versions.scalaYaml}"
    )

    // WartRemover is a JVM-only compiler plugin, so this platform takes the cross-platform flags
    // without the wart traversers.
    override def scalacOptions = BuildConfig.crossScalacOptions

    override def bunDevDeps = Task {
      // The TS MCP SDK is NOT a production dependency — no production source `@JSImport`s it, and
      // as a dev dependency it stays out of the published bun dependency manifest (mill-bun 0.3
      // schema v2). It is declared (pinned) here because the bun test workspace links this
      // module's node_modules: `js.test`'s conformance client resolves `@modelcontextprotocol/sdk`
      // from it. Without the pin, Bun's runtime auto-install fetched *latest at test time* — a CI
      // time bomb now that post-2026-07-28 SDK releases change initialize semantics. Resolution is
      // frozen by the committed `js/bun.lock` (regenerate with `./mill fast-mcp-scala.js.bunLock`).
      // Production boundary = the import graph, enforced by RootImportSurface tests, not
      // node_modules.
      Seq("@modelcontextprotocol/sdk@1.29.0")
    }

    // bunJsEnv is what BunScalaJSTests uses for the Bun process env
    override def bunJsEnv = Task {
      // Use the same JVM that Mill resolves for fast-mcp-scala.jvm (respects javaHome/jvmVersion)
      val serverJavaHome = jvm.javaHome().fold(os.Path(sys.props("java.home")))(_.path)
      val serverJavaCmd = (serverJavaHome / "bin" / "java").toString
      val serverClasspath =
        jvm.runClasspath().map(_.path.toString).mkString(java.io.File.pathSeparator)
      val serverJvmArgs =
        ujson.write(jvm.forkArgs())

      super.bunJsEnv() ++ Map(
        "FAST_MCP_PROJECT_ROOT" -> BuildCtx.workspaceRoot.toString,
        "FAST_MCP_SERVER_JAVA_CMD" -> serverJavaCmd,
        "FAST_MCP_SERVER_CLASSPATH" -> serverClasspath,
        "FAST_MCP_SERVER_JVM_ARGS_JSON" -> serverJvmArgs
      )
    }

    // ScalaJSTestDepsFix: see build.mill — keeps the Scala 2.13 stdlib out of the test link.
    // js/test/src plus shared/test/src (SharedTests), the tests every platform runs.
    object test extends BunScalaJSTests with TestModule.ScalaTest with ScalaJSTestDepsFix
        with SharedTests {
      override def mvnDeps = Seq(
        mvn"org.scalatest::scalatest::${Versions.scalaTest}"
      )

      // Force NODE_ENV=production inside the Bun test process so in-process
      // `Bun.serve({...})` calls default `development: false`. Without this the
      // dev-mode error overlay rewrites fetch-handler Promise rejections into a
      // ~100 KB HTML `BunError` Response, which hides the real error from tests
      // (see JsServerHttpTest's POST-initialize case).
      override def bunTestJsEnv = Task {
        super.bunTestJsEnv() + ("NODE_ENV" -> "production")
      }
    }
  }

  // Scala Native target (EXPERIMENTAL) — stdio over System.in/System.out plus streamable HTTP
  // over java.net.ServerSocket (jvm-native/), compiled to a standalone binary via LLVM. zio-http
  // is not published for Scala Native (upstream support is 4.x-milestoned, zio-http#2526), so
  // the HTTP given here is the hand-rolled socket backend around the shared
  // StreamableHttpHandler. Cross-published as `com.tjclp:fast-mcp-scala_native0.5_3`.
  object scalaNative extends ScalaNativeModule with ScalafmtModule with FastMCPPublishingBase {
    def scalaVersion = scala3Version
    def scalaNativeVersion = Versions.scalaNative

    // Mill module name stays `scalaNative` (the bare word "native" is claimed by the GraalVM
    // nativeSmoke pipeline); the source directory follows the jvm/js sibling convention.
    override def moduleDir = super.moduleDir / os.up / "native"

    // Native module reads from native/src/ (the platform backends), shared/ — the whole MCP core,
    // the schema-derivation macros, and the platform-pure examples — and jvm-native/src/ (the
    // socket HTTP layer shared with the JVM).
    override def sources = Task.Sources(
      moduleDir / "src",
      moduleDir / os.up / "shared" / "src",
      moduleDir / os.up / "jvm-native" / "src"
    )

    // `::` resolves the _native0.5_3 artifacts. zio-json transitively brings
    // io.github.cquiroz:scala-java-time (compile scope), which links the java.time.Duration
    // defaults in the shared McpServerSettings.
    override def mvnDeps = Seq(
      mvn"dev.zio::zio::${Versions.zio}",
      mvn"dev.zio::zio-json::${Versions.zioJson}",
      mvn"org.virtuslab::scala-yaml::${Versions.scalaYaml}"
    )

    // Deterministic main for `nativeLink`: shared/ carries several example mains, and this is the
    // one scripts/native-smoke.sh drives in CI.
    override def mainClass = Some("com.tjclp.fastmcp.examples.AnnotatedServer")

    /** The HTTP conformance binary (`scripts/conformance.sh scala-native`): this module's compiled
      * NIR re-linked with `ConformanceServerNative` as the entry point — no second module, nothing
      * published. Debug mode like `nativeLink`; `SCALANATIVE_MODE=release-fast` switches both.
      */
    def conformanceLink: T[PathRef] = Task {
      nativeLinkOtherMain("com.tjclp.fastmcp.examples.conformance.ConformanceServerNative")()
    }

    /** The benchmark binary (`bench/run.sh scala-native`): `BenchServerNative` as the entry point,
      * linked the same way as [[conformanceLink]].
      */
    def benchLink: T[PathRef] = Task {
      nativeLinkOtherMain("com.tjclp.fastmcp.examples.bench.BenchServerNative")()
    }

    // WartRemover is a JVM-only compiler plugin (same rationale as the js module).
    override def scalacOptions = BuildConfig.crossScalacOptions

    // native/test/src plus the socket-HTTP tests shared with the JVM test module
    // (CrossPlatformTests) — running them inside the linked native test binary is what proves the
    // socket layer on SN's threads.
    object test extends ScalaNativeTests with TestModule.ScalaTest with CrossPlatformTests {
      override def mvnDeps = Seq(
        mvn"org.scalatest::scalatest::${Versions.scalaTest}"
      )
    }
  }

  /** The server the Antithesis workload tests (`antithesis/mcp`): the JVM library plus a small
    * application with tools the driver can judge, and the Antithesis Java SDK for assertions inside
    * it. Not published; the SDK is on no other classpath. `stage` lays the jars out the way the
    * image wants them: `bin/` holds this project's own jars (instrumented by Antithesis), `lib/`
    * the third-party ones.
    */
  object antithesisSut extends ScalaModule {
    override def scalaVersion: T[String] = scala3Version
    override def moduleDeps = Seq(jvm)
    override def sources = Task.Sources(
      BuildCtx.workspaceRoot / "antithesis" / "mcp" / "sut" / "shared" / "src",
      BuildCtx.workspaceRoot / "antithesis" / "mcp" / "sut" / "jvm" / "src"
    )
    override def mvnDeps = Seq(mvn"com.antithesis:sdk:${Versions.antithesisSdk}")
    override def mainClass = Some("com.tjclp.fastmcp.antithesis.AntithesisSut")

    def stage: T[PathRef] = Task {
      val bin = Task.dest / "bin"
      val lib = Task.dest / "lib"
      os.makeDir.all(bin)
      os.makeDir.all(lib)
      os.copy(jvm.jar().path, bin / "fast-mcp-scala.jar")
      os.copy(jar().path, bin / "antithesis-sut.jar")
      resolvedRunMvnDeps().map(_.path).filter(_.ext == "jar").foreach { dep =>
        os.copy.over(dep, lib / dep.last)
      }
      PathRef(Task.dest)
    }
  }

  /** The same server under test for Bun: the shared tools plus a Scala.js launcher that writes its
    * assertions in the Antithesis fallback format. Not published. `stage` produces the optimized
    * bundle and its source map for the Bun image.
    *
    * Linked as a CommonJS module because Antithesis instruments the bundle: its JavaScript
    * instrumentation handles `require` by default and needs an account setting for `import`. The
    * source map lets it attribute coverage to the Scala sources.
    */
  object antithesisSutJs extends BunScalaJSModule {
    def scalaVersion = scala3Version
    def scalaJSVersion = Versions.scalaJs
    override def moduleKind = Task { ModuleKind.CommonJSModule }
    override def moduleDeps = Seq(js)
    override def sources = Task.Sources(
      BuildCtx.workspaceRoot / "antithesis" / "mcp" / "sut" / "shared" / "src",
      BuildCtx.workspaceRoot / "antithesis" / "mcp" / "sut" / "js" / "src"
    )
    override def scalacOptions = BuildConfig.crossScalacOptions

    def stage: T[PathRef] = Task {
      val linked = fullLinkJS().dest.path
      os.copy(linked / "main.js", Task.dest / "main.js")
      os.copy(linked / "main.js.map", Task.dest / "main.js.map")
      PathRef(Task.dest)
    }
  }

  /** GraalVM native-image smoke binaries (NOT published — verify with `resolve __.publishArtifacts`).
    *
    * These exist so CI proves that a downstream `NativeImageModule` build against fast-mcp-scala
    * needs zero hand-written reachability config (GH #66 / TJC-2114). One object per binary,
    * because `NativeImageModule` builds from `finalMainClass`. Exercised by
    * `scripts/native-smoke.sh` and `.github/workflows/native.yml`.
    */
  object nativeSmoke extends Module {

    trait NativeSmokeModule extends ScalaModule with mill.javalib.NativeImageModule {
      override def scalaVersion: T[String] = scala3Version
      override def moduleDeps = Seq(jvm)

      // GraalVM scoped to the smoke modules ONLY — setting jvmVersion on the published jvm
      // module would silently change its compile/test JVM. Provisioned by Mill via the coursier
      // JVM index; pinned exactly (bump deliberately, in step with docs/native-image.md).
      override def jvmVersion: T[String] = Task { "graalvm-community:25.0.2" }

      override def nativeImageOptions = Task {
        super.nativeImageOptions() ++ Seq(
          "--no-fallback" // fail the build rather than emit a JVM-hosted fallback image
        )
      }
    }

    /** Stdio smoke: AnnotatedServer covers the full surface a downstream stdio server hits at
      * runtime — macro-registered tools/prompts/resources and native JSON-schema materialization
      * at registration/tools-list time.
      */
    object stdio extends NativeSmokeModule {
      override def mainClass = Some("com.tjclp.fastmcp.examples.AnnotatedServer")

      // Neutralize Mill's GraalVM-reachability-metadata-repo integration FOR THIS MODULE: netty
      // stays in the resolved deps (moduleDeps can't exclude it the way a downstream dependency
      // exclusion does, only the classpath filter below), so Mill would otherwise inject stale
      // 4.1.x-era netty repo configs referencing classes this image doesn't carry. A downstream
      // stdio build that excludes zio-http needs NEITHER override — Mill's defaults are correct
      // there (and other dependencies keep their repo metadata).
      override def nativeMetadataConfigurations =
        Task { Set.empty[mill.javalib.graalvm.MetadataResult] }
      override def nativeExcludedConfigJars = Task { Seq.empty[PathRef] }

      // A stdio-only server has no reachable path into the HTTP stack (the transport-seam split),
      // so drop zio-http/netty from the image classpath — the same shape as a downstream
      // stdio-only build that excludes the zio-http dependency. This isn't just size hygiene:
      // netty's own in-jar reflect-config unconditionally registers methods whose signatures
      // mention netty buffer types, forcing them reachable, and netty's
      // `--initialize-at-build-time=io.netty` then allocates a native MemorySegment in
      // EmptyByteBuf.<clinit> on JDK 25 — an image-heap error. Reachability truth is proven by
      // the smoke run: any seam leak resurfaces as a linking/runtime failure.
      override def nativeImageClasspath = Task {
        super.nativeImageClasspath().filterNot { ref =>
          val name = ref.path.last
          name.startsWith("netty-") || name.startsWith("zio-http")
        }
      }
    }

    /** HTTP smoke: the conformance server over streamable HTTP — the strongest possible check
      * (the official MCP conformance suite runs against the native binary; see
      * `scripts/conformance.sh native`). Netty stays on the classpath here, so this module owns
      * the netty-under-native-image flags.
      */
    object http extends NativeSmokeModule {
      override def mainClass = Some("com.tjclp.fastmcp.examples.conformance.ConformanceServerJvm")

      // Netty-scoped counter to the stale GraalVM-metadata-repo entries: the repo marks netty
      // `override: true` but its newest netty configs are 4.1.x-era (predating netty 4.2's
      // module renames). With the latest-config fallback off, the 4.2.x version in use
      // (`Versions.netty`, untested by the repo) gets no repo config and no `--exclude-config`
      // stripping of its own (correct) in-jar metadata — while every other dependency keeps
      // Mill's default repo-metadata behavior.
      override def nativeUseLatestConfigWhenVersionIsUntested = Task { false }

      override def nativeImageOptions = Task {
        super.nativeImageOptions() ++ Seq(
          // SIGINT/SIGTERM must terminate a long-running server binary. GraalVM 25 installs the
          // exit handlers for executables by default and reports this flag as deprecated at build
          // time ("enabled by default for executables and it can likely be removed"). It is kept
          // only so that the module still builds a correct image on an older GraalVM.
          "--install-exit-handlers",
          // netty-codec-http ships a blanket `--initialize-at-build-time=io.netty`, which is
          // incompatible with GraalVM on JDK 25: buffer/handler <clinit>s allocate native memory
          // (FFM Arena via CleanerJava25) and bake response objects into the image heap. Equal
          // specificity + later rule wins, so this CLI arg re-defaults the whole netty tree to
          // run-time init (netty's own class-specific run-time entries are unaffected).
          "--initialize-at-run-time=io.netty",
          // netty's JDK-25 direct-buffer cleaner allocates via Arena.ofShared at RUNTIME; without
          // this, the first cleaner allocation throws UnsupportedFeatureError, killing event-loop
          // threads one by one (service limps along on the survivors) and deadlocking SIGTERM
          // shutdown. Found by dogfooding; the conformance gate now greps the server log for it.
          "-H:+UnlockExperimentalVMOptions",
          "-H:+SharedArenaSupport"
        )
      }
    }
  }
}
