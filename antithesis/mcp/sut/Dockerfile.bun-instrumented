# EXPERIMENT: the Bun server under test with its bundle offered to Antithesis's JavaScript
# instrumentation. Selected with SUT_BUN_DOCKERFILE=Dockerfile.bun-instrumented at build time.
#
# Antithesis documents JavaScript instrumentation for Node only ("contact us if you'd like to use
# a different runtime"), supports `require` by default (`import` needs an account setting), and
# follows a bundle's source map. So this image differs from Dockerfile.bun in three ways: the
# bundle is the CommonJS link (`./mill fast-mcp-scala.antithesisSutCjs.stage`), it ships with its
# source map and a package.json that names the module, and /opt/antithesis/catalog points at it.
# Whether the instrumented bundle then runs under Bun is what the experiment finds out.
ARG SUT_PLATFORM=linux/amd64
FROM --platform=${SUT_PLATFORM} debian:trixie-slim
ARG BUN_VERSION=1.4.1
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl jq unzip \
    && rm -rf /var/lib/apt/lists/*
RUN set -eu; \
    case "$(dpkg --print-architecture)" in \
      amd64) asset=bun-linux-x64-baseline; sum=a8c9c6738202e2fced555dd860a953c56c0cd059f75041e7010ae81a32802646 ;; \
      arm64) asset=bun-linux-aarch64; sum=580ce77533108dc6b10bec1721397e4f5aa44e909726da2451d483dfc5e581d6 ;; \
      *) echo "unsupported architecture" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/bun.zip "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/${asset}.zip"; \
    echo "${sum}  /tmp/bun.zip" | sha256sum -c -; \
    unzip -q /tmp/bun.zip -d /tmp; \
    install -m 755 "/tmp/${asset}/bun" /usr/local/bin/bun; \
    rm -rf /tmp/bun.zip "/tmp/${asset}"
COPY stage/cjs/main.js stage/cjs/main.js.map /opt/app/
COPY bun-entry.cjs /opt/app/entry.cjs
# The instrumentor only treats a directory as an application when it (or an ancestor) holds a
# `node_modules` directory; without one it logs "Couldn't find a node_modules in any ancestor
# directory - skipping instrumentation" and leaves the bundle untouched (first attempt, run
# 4ea61d2d86656b0595d50cb1ab8960e8-66-21). This bundle has no dependencies, so the directory is
# empty.
RUN printf '{"name":"fast-mcp-scala-sut-bun","version":"0.0.0","private":true,"main":"entry.cjs"}\n' > /opt/app/package.json \
    && mkdir -p /opt/app/node_modules \
    && mkdir -p /opt/antithesis && ln -s /opt/app /opt/antithesis/catalog
ENV SUT_PORT=8000
CMD ["sh", "-c", "exec bun run /opt/app/entry.cjs \"$SUT_PORT\""]
